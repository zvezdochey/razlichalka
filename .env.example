# Скопируй в .env и поправь путь, если датасет лежит в другом месте
DATASETS_PATH=./ПАКЕТ/ЗАДАНИЕ/data

# Папка с проверками организаторов (check_*.py)
CHECKS_PATH=./ПАКЕТ/ЗАДАНИЕ/checks

# Порт, на котором открывается интерфейс (если 3000 занят другим стеком)
FRONTEND_PORT=3000

# Порт бэка на хосте (если 8000 занят)
BACKEND_PORT=8000

# «Мнение ИИ» (G3): облачная Gemma через Ollama Cloud. Ключ — на https://ollama.com/settings/keys
# Без ключа отчёт работает, блок «Мнение ИИ» просто пишет «недоступно».
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# OLLAMA_URL=https://ollama.com   # только https: ключ уходит в заголовке
# OLLAMA_TIMEOUT=60
# OLLAMA_RETRIES=2
