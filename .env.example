# Скопируй в .env и поправь путь, если датасет лежит в другом месте
DATASETS_PATH=./ПАКЕТ/ЗАДАНИЕ/data

# Папка с проверками организаторов (check_*.py)
CHECKS_PATH=./ПАКЕТ/ЗАДАНИЕ/checks

# Порт, на котором открывается интерфейс (если 3000 занят другим стеком)
FRONTEND_PORT=3000

# Порт бэка на хосте (если 8000 занят)
BACKEND_PORT=8000
